PORT=3000
HOST=0.0.0.0
NODE_ENV=development
DATABASE_URL=postgresql://<APP_ROLE>:<URL_ENCODED_PASSWORD>@<APP_DATABASE_HOST>/<APP_DATABASE>?sslmode=require
MIGRATION_DATABASE_URL=postgresql://<MIGRATION_ROLE>:<URL_ENCODED_PASSWORD>@<MIGRATION_DATABASE_HOST>/<NON_PRODUCTION_DATABASE>?sslmode=require
MIGRATION_ACTOR=<OPERATOR_IDENTIFIER>
CLOUDINARY_CLOUD_NAME=<CLOUDINARY_CLOUD_NAME>
CLOUDINARY_API_KEY=<CLOUDINARY_API_KEY>
CLOUDINARY_API_SECRET=<CLOUDINARY_API_SECRET>
SESSION_TTL_HOURS=24
CORS_ORIGIN=http://localhost:8081,http://127.0.0.1:8081
